# APEX 2.0 — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# ── Gmail Alerts ────────────────────────────────────────────────────────────
# Required for sending email alerts from notify/gmail_alert.py.
# How to get: Google Account → Security → 2-Step Verification → App Passwords
# Create an App Password for "Mail" on "Other device", name it "APEX".
# Format: four groups of four letters, e.g. "abcd efgh ijkl mnop"
GMAIL_APP_PASSWORD=

# ── LLM (Agent Layer — optional) ────────────────────────────────────────────
# Only needed if running agent/model_router.py with cloud fallback.
# Primary: Ollama qwen3.8:27b-mlx on Mac Mini M4 (no key needed).
# Fallback: Gemini 2.5 Flash (get key at aistudio.google.com/apikey)
GEMINI_API_KEY=

# ── Data sources ────────────────────────────────────────────────────────────
# Bundesbank and ECB APIs are public — no key needed.
# yfinance is unofficial Yahoo Finance — no key needed.
