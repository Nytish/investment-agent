{
  "name": "investment-agent",
  "version": "1.0.0",
  "description": "AI Investment Portfolio Agent — Personal Financial Co-pilot for Nitish",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "serve": "ts-node src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/src/__tests__/**/*.test.ts"],
    "moduleNameMapper": {
      "^../services/FirestoreService$": "<rootDir>/src/__tests__/__mocks__/FirestoreService.ts",
      "^../../services/FirestoreService$": "<rootDir>/src/__tests__/__mocks__/FirestoreService.ts"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "chalk": "^4.1.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "firebase-admin": "^12.2.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
